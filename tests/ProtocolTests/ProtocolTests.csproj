<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ProtocolTests</AssemblyName>
    <RootNamespace>IcarusII.Tests</RootNamespace>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    直接把 mod 的 Shared 源码编进来，而不是引用工程：
    Shared 是刻意保持 Unity-free 的，同一份源码既进 IcarusII.dll 也进本测试程序，
    这样 M0 就能在没有游戏的情况下端到端验证 C# 侧代码。
  -->
  <ItemGroup>
    <Compile Include="../../mod/src/Shared/**/*.cs" />
    <!-- 确认/租约服务不依赖 UnityEngine，直接编进测试程序 -->
    <Compile Include="../../mod/src/IcarusII/Core/ConfirmationService.cs" Link="ConfirmationService.cs" />
    <!-- A.14.7：快捷键组合的解析/格式化/字符判定刻意不依赖 UnityEngine -->
    <Compile Include="../../mod/src/IcarusII/Input/KeyChord.cs" Link="KeyChord.cs" />
    <!-- 目标面板的等级覆盖状态机不依赖 UnityEngine，恢复错了会改掉玩家的目标设置 -->
    <Compile Include="../../mod/src/IcarusII/Game/GoalLevelSwap.cs" Link="GoalLevelSwap.cs" />
    <!-- AI 目标的完成/跳过状态只能存在存档 JSON 里，编码或过滤错了重启就会重新弹出 -->
    <Compile Include="../../mod/src/IcarusII/Game/GoalStore.cs" Link="GoalStore.cs" />
    <!-- 顾问提示的截断/转义/快捷键着色不依赖 UnityEngine，面板宽度全靠这里压字数 -->
    <Compile Include="../../mod/src/IcarusII/UI/AdvisorText.cs" Link="AdvisorText.cs" />
    <!-- 作答选项的显示文案（标题 + 灰色说明）不依赖 UnityEngine，格式漂了游戏里会露出裸标签 -->
    <Compile Include="../../mod/src/IcarusII/UI/AskModels.cs" Link="AskModels.cs" />
    <Compile Include="../../mod/src/IcarusII/UI/AskOptionText.cs" Link="AskOptionText.cs" />
  </ItemGroup>

</Project>
