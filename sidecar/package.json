{
  "name": "icarus-ii-sidecar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "icarus-ii 本地 sidecar：WebSocket 服务端（协议 v1），M1 为 LLM 驱动的对话 agent",
  "license": "MIT",
  "bin": {
    "icarus-ii-sidecar": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "node dist/index.js serve",
    "dev": "tsx src/index.ts serve",
    "test:negative": "node test/negative.mjs",
    "test:config": "node test/config.mjs",
    "test:config-protocol": "node test/config-protocol.mjs",
    "test:model-catalog": "node test/model-catalog.mjs",
    "test:pi-loopback": "node test/pi-loopback.mjs",
    "test:tools": "node test/tools.mjs",
    "test:tools-view": "node test/tools-view.mjs",
    "test:pi-tools": "node test/pi-tools.mjs",
    "test:live": "node test/live.mjs",
    "test": "npm run typecheck && npm run build && npm run test:negative && npm run test:config && npm run test:config-protocol && npm run test:model-catalog && npm run test:pi-loopback && npm run test:tools && npm run test:tools-view && npm run test:pi-tools && npm run test:kb && npm run test:kb-tools && npm run test:kb-session && npm run test:kb-plan && npm run test:script && npm run test:wiki && npm run test:blueprint && npm run test:history && npm run test:history-delete",
    "test:kb": "node test/kb.mjs",
    "test:kb-tools": "node test/kb-tools.mjs",
    "test:kb-session": "node test/kb-session.mjs",
    "test:kb-plan": "node test/kb-plan.mjs",
    "test:script": "node test/script.mjs",
    "test:wiki": "node test/wiki.mjs",
    "test:blueprint": "node test/blueprint.mjs",
    "test:history": "node test/history.mjs",
    "test:history-delete": "node test/history-delete.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "typebox": "^1.1.38",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
