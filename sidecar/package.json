{
  "name": "icarus-ii-sidecar",
  "version": "1.2.381",
  "private": true,
  "type": "module",
  "description": "icarus-ii 本地 sidecar：WebSocket 服务端（协议 v1），M1 为 LLM 驱动的对话 agent",
  "license": "MIT",
  "bin": {
    "icarus-ii-sidecar": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "gen:prompts": "node scripts/gen-prompts.mjs",
    "pretypecheck": "node scripts/gen-prompts.mjs",
    "prebuild": "node scripts/gen-prompts.mjs",
    "predev": "node scripts/gen-prompts.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-planner.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "node dist/index.js serve",
    "dev": "tsx src/index.ts serve",
    "test:prompts": "node test/prompts.mjs",
    "test:negative": "node test/negative.mjs",
    "test:config": "node test/config.mjs",
    "test:config-protocol": "node test/config-protocol.mjs",
    "test:model-catalog": "node test/model-catalog.mjs",
    "test:pi-loopback": "node test/pi-loopback.mjs",
    "test:tool-menu": "node test/tool-menu.mjs",
    "test:tool-debug": "node test/tool-debug.mjs",
    "test:tools": "node test/tools.mjs",
    "test:sandbox": "node test/sandbox.mjs",
    "test:tools-view": "node test/tools-view.mjs",
    "test:pi-tools": "node test/pi-tools.mjs",
    "test:tool-docs": "node test/tool-docs.mjs",
    "test:live": "node test/live.mjs",
    "test": "npm run typecheck && npm run build && npm run test:prompts && npm run test:link-card && npm run test:negative && npm run test:config && npm run test:config-protocol && npm run test:model-catalog && npm run test:provider-endpoint && npm run test:pi-loopback && npm run test:tool-menu && npm run test:tool-debug && npm run test:tools && npm run test:sandbox && npm run test:tools-view && npm run test:pi-tools && npm run test:kb && npm run test:kb-tools && npm run test:kb-session && npm run test:kb-plan && npm run test:script && npm run test:wiki && npm run test:wiki-alias && npm run test:blueprint && npm run test:blueprint-fs && npm run test:blueprint-card && npm run test:blueprint-plan && npm run test:blueprint-validate && npm run test:blueprint-emit && npm run test:blueprint-tiers && npm run test:history && npm run test:conversations && npm run test:parallel-sessions && npm run test:locks && npm run test:interrupt && npm run test:game-time && npm run test:history-delete && npm run test:tool-docs && npm run test:settings",
    "test:kb": "node test/kb.mjs",
    "test:kb-tools": "node test/kb-tools.mjs",
    "test:kb-session": "node test/kb-session.mjs",
    "test:kb-plan": "node test/kb-plan.mjs",
    "test:script": "node test/script.mjs",
    "test:wiki": "node test/wiki.mjs",
    "test:blueprint": "node test/blueprint.mjs",
    "test:blueprint-card": "node test/blueprint-card.mjs",
    "test:link-card": "node test/link-card.mjs",
    "test:history": "node test/history.mjs",
    "test:conversations": "node test/conversations.mjs",
    "test:parallel-sessions": "node test/parallel-sessions.mjs",
    "test:locks": "node test/locks.mjs",
    "test:history-delete": "node test/history-delete.mjs",
    "test:blueprint-plan": "node test/blueprint-plan.mjs",
    "test:wiki-alias": "node test/wiki-alias.mjs",
    "test:blueprint-tiers": "node test/blueprint-tiers.mjs",
    "test:blueprint-fs": "node test/blueprint-fs.mjs",
    "test:game-time": "node test/game-time.mjs",
    "test:provider-endpoint": "node test/provider-endpoint.mjs",
    "test:settings": "node test/settings.mjs",
    "test:interrupt": "node test/interrupt.mjs",
    "test:blueprint-validate": "node test/blueprint-validate.mjs",
    "test:blueprint-emit": "node test/blueprint-emit.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "typebox": "^1.4.5",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
